        {
          "name": "Login User (Auto-extract Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const token = res.token || (res.data && res.data.token);",
                  "if (token) {",
                  "    pm.environment.set('accessToken', token);",
                  "    pm.test('Token successfully extracted and saved', () => pm.expect(token).to.not.be.empty);",
                  "} else {",
                  "    console.warn('Token not found in response');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer_test@smarttrip.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
